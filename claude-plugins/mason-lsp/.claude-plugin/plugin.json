{
  "name": "mason-lsp",
  "description": "Language servers from nvim's Mason (~/.local/share/nvim/mason/bin on PATH), mapped by file extension. A new server = a Mason package in the nvim config + one entry here.",
  "version": "1.0.0",
  "author": { "name": "cwchen-twn" },
  "lspServers": {
    "gopls": {
      "command": "gopls",
      "extensionToLanguage": { ".go": "go" }
    },
    "pyrefly": {
      "command": "pyrefly",
      "args": ["lsp"],
      "extensionToLanguage": { ".py": "python", ".pyi": "python" }
    },
    "vtsls": {
      "command": "vtsls",
      "args": ["--stdio"],
      "extensionToLanguage": {
        ".ts": "typescript",
        ".tsx": "typescriptreact",
        ".mts": "typescript",
        ".cts": "typescript",
        ".js": "javascript",
        ".jsx": "javascriptreact",
        ".mjs": "javascript",
        ".cjs": "javascript"
      }
    },
    "svelte": {
      "command": "svelteserver",
      "args": ["--stdio"],
      "extensionToLanguage": { ".svelte": "svelte" }
    },
    "rust-analyzer": {
      "command": "rust-analyzer",
      "extensionToLanguage": { ".rs": "rust" }
    },
    "jdtls": {
      "command": "jdtls",
      "extensionToLanguage": { ".java": "java" },
      "startupTimeout": 120000
    },
    "clangd": {
      "command": "clangd",
      "extensionToLanguage": { ".c": "c", ".h": "c", ".cc": "cpp", ".cpp": "cpp", ".hpp": "cpp" }
    },
    "yaml": {
      "command": "yaml-language-server",
      "args": ["--stdio"],
      "extensionToLanguage": { ".yaml": "yaml", ".yml": "yaml" }
    },
    "tombi": {
      "command": "tombi",
      "args": ["lsp"],
      "extensionToLanguage": { ".toml": "toml" }
    },
    "terraform-ls": {
      "command": "terraform-ls",
      "args": ["serve"],
      "extensionToLanguage": { ".tf": "terraform", ".tfvars": "terraform-vars" }
    },
    "bash": {
      "command": "bash-language-server",
      "args": ["start"],
      "extensionToLanguage": { ".sh": "shellscript", ".bash": "shellscript" }
    },
    "fish": {
      "command": "fish-lsp",
      "args": ["start"],
      "extensionToLanguage": { ".fish": "fish" }
    },
    "postgres": {
      "command": "postgres-language-server",
      "args": ["lsp-proxy"],
      "extensionToLanguage": { ".sql": "sql" }
    },
    "marksman": {
      "command": "marksman",
      "args": ["server"],
      "extensionToLanguage": { ".md": "markdown" }
    }
  }
}
