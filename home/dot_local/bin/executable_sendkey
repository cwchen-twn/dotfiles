#!/usr/bin/env bash
# sendkey KEYS: press a key combination, xdotool style (ctrl+alt+Left, alt+F1, ctrl+plus), through wtype (the Wayland
# virtual keyboard protocol). Used by the touchpad gestures (~/.config/libinput-gestures.conf); labwc's rc.xml binds
# the keys.
set -eu
[ $# -eq 1 ] || {
    echo "usage: sendkey KEY[+KEY...]" >&2
    exit 2
}
IFS=+ read -ra parts <<<"$1"
key=${parts[-1]}
unset 'parts[-1]'
mods=()
for m in "${parts[@]}"; do
    case $m in
        super) m=logo ;;
        control) m=ctrl ;;
    esac
    mods+=("$m")
done
args=()
for m in "${mods[@]}"; do args+=(-M "$m"); done
args+=(-k "$key")
for m in "${mods[@]}"; do args+=(-m "$m"); done
exec wtype "${args[@]}"
