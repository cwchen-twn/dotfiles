#!/usr/bin/env bash
# kbd-backlight-idle off|on: the MacBook keyboard backlight off when idle, back to the previous level on the next
# input. Run by swayidle's timeout/resume (~/.config/labwc/autostart, 60 s); the level is kept in $XDG_RUNTIME_DIR
# between the two. Needs brightnessctl (ansible macbook role).
set -u
dev=smc::kbd_backlight
[ -e "/sys/class/leds/$dev" ] || exit 0
state=${XDG_RUNTIME_DIR:-/tmp}/kbd-backlight-idle.level

case ${1:-} in
    off)
        cur=$(brightnessctl -d "$dev" get) || exit 0
        [ "$cur" -gt 0 ] || exit 0
        echo "$cur" >"$state" && brightnessctl -q -d "$dev" set 0
        ;;
    on)
        [ -s "$state" ] || exit 0
        brightnessctl -q -d "$dev" set "$(cat "$state")"
        rm -f "$state"
        ;;
    *)
        echo "usage: kbd-backlight-idle off|on" >&2
        exit 2
        ;;
esac
