#!/usr/bin/env bash
# lock-screen: lock the session with swaylock on the login screen's background (the SDDM astronaut theme's image), so
# unlocking looks like logging in. Type the password and press Enter: there is no box, only a ring that reacts to
# keys (red: wrong password). Run by swayidle (~/.config/labwc/autostart) on idle, before sleep and when anything asks
# logind to lock (LXQt's "Lock screen", Ctrl+Alt+L, `loginctl lock-session`).
set -u
src=/usr/share/sddm/themes/sddm-astronaut-theme/Backgrounds/dotfiles-login.jpg
pgrep -xu "$EUID" swaylock >/dev/null && exit 0
args=(--daemonize --ignore-empty-password --show-failed-attempts --color=11111b)
[ -r "$src" ] && args+=(--image="$src" --scaling=fill)
# --daemonize returns once the screen is locked: swayidle -w then lets sleep go on.
exec swaylock "${args[@]}"
