#!/usr/bin/env bash
# debian-release-upgrade [--dry-run] [CODENAME]: move this machine to the next Debian release (trixie -> forky), by
# hand and with checks, never unattended. The Debian sources are pinned to the codename (not "stable"), so a new
# release changes nothing until this runs. Wait for the x.1 point release and read the release notes first:
# https://www.debian.org/releases/<codename>/releasenotes
#
# Steps: refuse unless the target is released and the machine is ready (AC power, free space, no broken or held
# packages); back up the apt sources; switch the Debian entries (sources.list, debian.sources) to the new codename;
# apt upgrade --without-new-pkgs, then full-upgrade (both ask before changing anything), autoremove; then
# chezmoi apply, which reruns Ansible: the third-party repos (Docker, Tailscale, PostgreSQL, ...) follow the codename
# Ansible sees. One that doesn't publish the new codename yet fails there; fix or wait, then chezmoi apply again.
# --dry-run: run the checks and show the sources change, touch nothing.
# shellcheck disable=SC1091,SC2016  # os-release is sourced at run time; check() evals its quoted test
set -euo pipefail

next_of() { case $1 in bookworm) echo trixie ;; trixie) echo forky ;; forky) echo duke ;; *) return 1 ;; esac; }

dry=false
[ "${1:-}" = --dry-run ] && { dry=true; shift; }
. /etc/os-release
[ "${ID:-}" = debian ] || { echo "Debian only (this is ${ID:-unknown})" >&2; exit 1; }
current=${VERSION_CODENAME:?no VERSION_CODENAME in /etc/os-release}
target=${1:-$(next_of "$current")} || { echo "no known release after $current: pass the codename" >&2; exit 1; }
echo "Debian $current -> $target"

fail=false
check() { if eval "$2"; then echo "  ok    $1"; else echo "  FAIL  $1"; fail=true; fi; }
# Released = deb.debian.org has dists/<target>/Release and its Suite is "stable" (testing has one long before).
suite=$(curl -fsSL "https://deb.debian.org/debian/dists/$target/Release" 2>/dev/null | sed -n 's/^Suite: //p')
check "$target is released (suite: ${suite:-not found})" '[ "$suite" = stable ]'
on_ac() {
    local s found=false
    for s in /sys/class/power_supply/*; do
        [ "$(cat "$s/type" 2>/dev/null)" = Mains ] || continue
        found=true
        [ "$(cat "$s/online" 2>/dev/null)" = 1 ] && return 0
    done
    ! $found   # desktops have no Mains supply listed
}
check "on AC power" on_ac
check "5 GB free in /" '[ "$(df --output=avail -k / | tail -n 1)" -ge 5242880 ]'
check "300 MB free in /boot" '[ "$(df --output=avail -k /boot | tail -n 1)" -ge 307200 ]'
check "no broken packages (apt-get check)" 'apt-get check -o Debug::NoLocking=1 >/dev/null 2>&1'  # read-only: no root, no lock
check "no held packages" '[ -z "$(apt-mark showhold)" ]'
check "no half-installed packages (dpkg --audit)" '[ -z "$(dpkg --audit)" ]'

# Debian's own sources only: the classic file and the deb822 one the installer may write. Third-party files are
# rewritten by Ansible afterwards.
files=()
for f in /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources; do
    [ -f "$f" ] && grep -q "\b$current\b" "$f" && files+=("$f")
done
[ ${#files[@]} -gt 0 ] || { echo "  FAIL  no Debian source mentions $current"; fail=true; }
for f in "${files[@]}"; do
    echo "--- $f"
    sed "s/\b$current\b/$target/g" "$f" | diff -u "$f" - | sed -n '/^[-+][^-+]/p' || true
done

$fail && { echo "Not upgrading: fix the FAIL lines above." >&2; exit 1; }
$dry && { echo "Dry run: nothing changed."; exit 0; }
read -rp "Upgrade to $target now? [y/N] " ok
[ "$ok" = y ] || exit 1

backup=/var/backups/apt-sources-$(date +%F-%H%M%S)
sudo mkdir -p "$backup"
sudo cp -a /etc/apt/sources.list* "$backup"/
echo "sources backed up to $backup"
for f in "${files[@]}"; do sudo sed -i "s/\b$current\b/$target/g" "$f"; done

sudo apt update
sudo apt upgrade --without-new-pkgs
sudo apt full-upgrade
sudo apt autoremove
command -v chezmoi >/dev/null && chezmoi apply
echo "Done: reboot now, then check 'cat /etc/debian_version' and the desktop."
