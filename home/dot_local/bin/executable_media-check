#!/usr/bin/env bash
# media-check [--decode]: the audio/video decisions of this setup, checked against the running system.
# --decode also runs brave-decode-test (plays a clip in a throwaway Brave: the only real proof of GPU decoding).
# ✔ as decided, ✘ drifted (with a hint), – not applicable right now. Exit code = number of ✘.
# Brave, PulseAudio/PipeWire and the OS change interfaces over time; this is the quick way to notice. Cost: cpu-stat.
set -u

# ---------------------------------------------------------------- the decisions (change here when they change)
BT_POLICY_ARG="auto_switch=2"                                                       # headphones switch to the headset profile (mic) when any app records
BT_AVOID_CODEC="ldac"                                                               # LDAC costs about half a core to encode on a 2015 dual-core: bt-codec / WirePlumber avoid it
BT_WP_CODECS="sbc_xq sbc"                                                           # under PipeWire: WirePlumber's A2DP codec list (no LDAC)
SUPERSONIC_TRANSCODE=(RequestTranscode=true Codec=opus MaxBitRateKBPS=192)          # Opus instead of raw FLAC
MEDIA_KEYS=(XF86AudioPlay=playerctl XF86AudioNext=playerctl XF86AudioPrev=playerctl # key=command it must run,
    XF86AudioRaiseVolume=vol XF86AudioLowerVolume=vol XF86AudioMute=vol)            # as its only enabled binding
VAAPI_NEED="VideoProc"                                                              # Chromium's VA-API decoder on older Intel needs the driver's post-processing (non-free iHD)
BRAVE_VULKAN="Vulkan,DefaultANGLEVulkan,VulkanFromANGLE"                            # X11 only: Brave composites with Vulkan (GL conversion corrupted frames); Wayland has EGL
BRAVE_H264IFY="omkfmpieigblcllmkgbflkikinpkodlk"                                    # enhanced-h264ify
BRAVE_DARK="WebContentsForceDark"                                                   # Blink darkens pages: Dark Reader's per-page script cost CPU
BRAVE_NO_EXT="eimadpbcbfnmbkopoojfekhnkhdbieeh"                                     # Dark Reader, replaced by BRAVE_DARK
# --------------------------------------------------------------------------------------------------------------

fails=0
ok() { printf '  \e[32m✔\e[0m %-38s %s\n' "$1" "$2"; }
bad() {
    printf '  \e[31m✘\e[0m %-38s %s\n' "$1" "$2"
    [ -n "${3:-}" ] && printf '      \e[2m→ %s\e[0m\n' "$3"
    fails=$((fails + 1))
}
# has_features "args" "A,B": every feature in the list is in the args' (last) --enable-features
has_features() {
    local have f
    have=$(grep -oE -- '--enable-features=[^ ]*' <<<"$1" | tail -1)
    for f in ${2//,/ }; do [[ ",${have#*=}," == *",$f,"* ]] || return 1; done
}
na() { printf '  \e[2m– %-38s %s\e[0m\n' "$1" "$2"; }
section() { printf '\n\e[1m%s\e[0m\n' "$1"; }

# ---------------------------------------------------------------- audio
section "Audio"
pipewire=false
if pactl info >/dev/null 2>&1; then
    server=$(pactl info | sed -n 's/^Server Name: //p')
    [[ $server == *PipeWire* ]] && pipewire=true
    ok "sound server" "$server $(pactl info | sed -n 's/^Server Version: //p')"
    if $pipewire; then
        # WirePlumber switches to the headset profile when an app records (its default); Bluetooth needs libspa's plugin.
        if dpkg-query -W -f='${Status}' libspa-0.2-bluetooth 2>/dev/null | grep -q 'ok installed'; then
            ok "Bluetooth audio (PipeWire)" "libspa-0.2-bluetooth; headset profile by WirePlumber"
        else bad "Bluetooth audio (PipeWire)" "libspa-0.2-bluetooth missing: headphones can't play" "chezmoi apply (desktop role)"; fi
        wpconf=$HOME/.config/wireplumber/wireplumber.conf.d/51-bluez-codecs.conf
        have=$(sed -n 's/.*bluez5.codecs *= *\[ *\(.*[^ ]\) *\].*/\1/p' "$wpconf" 2>/dev/null)
        if [ "$have" = "$BT_WP_CODECS" ]; then
            ok "Bluetooth codecs (WirePlumber)" "$have (no $BT_AVOID_CODEC)"
        else bad "Bluetooth codecs (WirePlumber)" "'${have:-default: all}'" "chezmoi apply; systemctl --user restart wireplumber"; fi
    else
        arg=$(pactl list modules 2>/dev/null | awk '/Name: module-bluetooth-policy/ {f=1} f && /Argument:/ {sub(/^[^:]*: */, ""); print; exit}')
        if [ "$arg" = "$BT_POLICY_ARG" ]; then
            ok "headset profile when recording" "$arg"
        else bad "headset profile when recording" "module-bluetooth-policy: '${arg:-not loaded}'" "$HOME/.config/pulse/default.pa (chezmoi); pulseaudio -k to reload"; fi
    fi
    ok "default output" "$(pactl get-default-sink)"
    ok "default input" "$(pactl get-default-source)"
else
    bad "sound server" "pactl cannot reach it" "systemctl --user status pipewire-pulse pulseaudio"
fi
if pgrep -u "$(id -u)" -x pasystray >/dev/null; then
    ok "volume tray (pasystray)" "running"
elif command -v pasystray >/dev/null 2>&1; then
    bad "volume tray (pasystray)" "not running" "setsid -f pasystray --volume-max=100 --volume-inc=5 (autostarts at login)"
else bad "volume tray (pasystray)" "not installed" "chezmoi apply (apt pasystray, desktop role)"; fi
if grep -qE '^plugins=.*\bvolume\b' "$HOME/.config/lxqt/panel.conf" 2>/dev/null; then
    bad "panel volume widget" "still in the panel (shows a fixed device)" "chezmoi apply (lxqt role removes it)"
else ok "panel volume widget" "removed (pasystray instead)"; fi
if $pipewire; then
    na "bt-codec service" "PulseAudio only (WirePlumber picks the codec)"
elif systemctl --user is-active -q bt-codec.service; then
    ok "bt-codec service" "active"
else bad "bt-codec service" "$(systemctl --user is-active bt-codec.service)" "systemctl --user enable --now bt-codec.service"; fi
cards=$(pactl list short cards 2>/dev/null | awk '$2 ~ /^bluez_card\./ {print $2}')
if [ -z "$cards" ]; then na "Bluetooth audio device" "none connected"; fi
for card in $cards; do
    name=$(bluetoothctl info "$(echo "${card#bluez_card.}" | tr _ :)" 2>/dev/null | sed -n 's/^\s*Name: //p')
    profile=$(pactl list cards | awk -v c="$card" '$0 ~ "Name: "c {f=1} f && /Active Profile:/ {print $3; exit}')
    if $pipewire; then
        codec=$(pactl list sinks 2>/dev/null | awk -v c="${card#bluez_card.}" '$0 ~ "Name: bluez_output."c {f=1} f && /api.bluez5.codec/ {gsub(/"/, "", $3); print $3; exit}')
    else codec=$(pactl send-message "/card/$card/bluez" get-codec 2>/dev/null | tr -d '"'); fi
    case $codec in
        "$BT_AVOID_CODEC"*) bad "${name:-$card}" "$profile, codec $codec" "PulseAudio: journalctl --user -u bt-codec; PipeWire: the WirePlumber codec list" ;;
        *) ok "${name:-$card}" "$profile, codec ${codec:-?}" ;;
    esac
done

# ---------------------------------------------------------------- music
section "Music (Supersonic)"
if command -v supersonic >/dev/null 2>&1 || [ -x "$HOME/.local/share/mise/shims/supersonic" ]; then
    ok "supersonic" "$(mise ls --current github:dweymouth/supersonic 2>/dev/null | awk 'NR==1 {print $2}')"
else bad "supersonic" "not installed" "mise install (supersonic in the chezmoi desktop list)"; fi
if { ldconfig -p 2>/dev/null || /usr/sbin/ldconfig -p 2>/dev/null || /sbin/ldconfig -p 2>/dev/null; } | grep -q 'libmpv.so.2'; then
    ok "libmpv" "libmpv.so.2"
else bad "libmpv" "missing" "chezmoi apply (apt libmpv2, desktop role)"; fi
conf=$HOME/.config/supersonic/config.toml
if [ -r "$conf" ]; then
    for kv in "${SUPERSONIC_TRANSCODE[@]}"; do
        k=${kv%%=*} want=${kv#*=}
        have=$(awk -v k="$k" '/^\[/ {s=$0} s=="[Transcoding]" && $1==k {print $3; exit}' "$conf" | tr -d "\"'")
        if [ "$have" = "$want" ]; then
            ok "stream $k" "$have"
        else bad "stream $k" "'${have:-unset}' (want $want)" "chezmoi apply ~/.config/supersonic (modify template)"; fi
    done
else na "stream settings" "no ~/.config/supersonic/config.toml yet"; fi
if command -v playerctl >/dev/null 2>&1; then
    players=$(playerctl -l 2>/dev/null | paste -sd, -)
    ok "playerctl" "players: ${players:-none running}"
else bad "playerctl" "missing" "chezmoi apply (apt playerctl, desktop role)"; fi
keys=$HOME/.config/lxqt/globalkeyshortcuts.conf
for kv in "${MEDIA_KEYS[@]}"; do
    k=${kv%%=*} want=${kv#*=}
    # every ENABLED binding of this key, as "Exec ..." or "path ..." (the panel volume widget registers its own)
    bound=$(awk -v k="$k" '
        /^\[/ { flush(); s = ($0 ~ "^\\[" k "\\."); en = 1; act = ""; next }
        s && /^Enabled=false/ { en = 0 }
        s && /^(Exec|path)=/ { act = $0 }
        function flush() { if (s && en && act != "") print act }
        END { flush() }' "$keys" 2>/dev/null)
    n=$(grep -c . <<<"$bound")
    case "$n:$bound" in
        "1:Exec="*"$want"*) ok "key $k" "${bound#Exec=}" ;;
        0:*) bad "key $k" "unbound" "chezmoi apply (lxqt role), then log in again" ;;
        *) bad "key $k" "$n binding(s): $(tr '\n' ';' <<<"$bound")" "chezmoi apply (lxqt role: one enabled binding per key)" ;;
    esac
done

# ---------------------------------------------------------------- video
section "Video (Brave / YouTube)"
if command -v vainfo >/dev/null 2>&1; then
    v=$(vainfo 2>/dev/null)
    drv=$(sed -n 's/.*Driver version: //p' <<<"$v" | head -1)
    profiles=$(grep -E 'VAEntrypointVLD' <<<"$v" | grep -oE 'VAProfile(H264|VP8|VP9|AV1|HEVC)[A-Za-z0-9]*' | sed 's/VAProfile//' | sort -u | paste -sd' ' -)
    if grep -q 'H264' <<<"$profiles"; then
        ok "GPU hardware decode" "$profiles"
    else bad "GPU hardware decode" "no H.264 decode (${profiles:-none})" "vainfo; drivers: intel-media-va-driver / i965-va-driver"; fi
    [ -n "$drv" ] && ok "VA-API driver" "$drv"
else bad "vainfo" "missing" "chezmoi apply (apt vainfo, desktop role)"; fi
pol=/etc/brave/policies/managed/dotfiles.json
if grep -q "$BRAVE_H264IFY" "$pol" 2>/dev/null; then
    ok "enhanced-h264ify (policy)" "force-installed"
else bad "enhanced-h264ify (policy)" "not in $pol" "chezmoi apply (desktop role)"; fi
if command -v vainfo >/dev/null 2>&1; then
    if grep -q "VAEntrypoint$VAAPI_NEED" <<<"$v"; then
        ok "VA-API post-processing" "$VAAPI_NEED (Brave can decode on the GPU)"
    else bad "VA-API post-processing" "no $VAAPI_NEED: Brave falls back to CPU decoding" "Intel: apt install intel-media-va-driver-non-free (desktop role)"; fi
fi
# Brave's flags (desktop role): force-dark everywhere, Vulkan on Intel graphics in X11 sessions only. The wrapper picks
# them per session; the menu entry starts the wrapper.
want_x11=$BRAVE_DARK
grep -qsx 0x8086 /sys/class/drm/card*/device/vendor && want_x11="$BRAVE_VULKAN,$BRAVE_DARK"
if [ -n "${WAYLAND_DISPLAY:-}" ]; then want=$BRAVE_DARK; else want=$want_x11; fi
launcher=$HOME/.local/share/applications/brave-browser.desktop
wrapper=$HOME/.local/bin/brave-browser
if grep -q "^Exec=$wrapper" "$launcher" 2>/dev/null; then
    ok "Brave menu entry" "starts the wrapper"
else bad "Brave menu entry" "doesn't start $wrapper" "chezmoi apply (desktop role generates it)"; fi
w=$(cat "$wrapper" 2>/dev/null)
if grep -q 'WAYLAND_DISPLAY' <<<"$w" && grep -q "features=$want_x11\b" <<<"$w" && grep -q "features=$BRAVE_DARK\b" <<<"$w"; then
    ok "brave-browser wrapper" "X11 $want_x11; Wayland $BRAVE_DARK"
else bad "brave-browser wrapper" "not the per-session flags in $wrapper" "chezmoi apply (desktop role generates it)"; fi
if grep -q "$BRAVE_NO_EXT" "$pol" 2>/dev/null; then
    bad "Dark Reader (policy)" "still force-installed (per-page CPU)" "chezmoi apply (desktop role)"
elif [ -d "$HOME/.config/BraveSoftware/Brave-Browser/Default/Extensions/$BRAVE_NO_EXT" ]; then
    bad "Dark Reader" "still installed (per-page CPU)" "restart Brave so the policy removes it, or remove it in brave://extensions"
else ok "Dark Reader" "not installed ($BRAVE_DARK instead)"; fi
main=$(pgrep -u "$(id -u)" -xo brave)
if [ -z "$main" ]; then
    na "running Brave" "not running"
else
    if has_features "$(tr '\0' ' ' </proc/"$main"/cmdline)" "$want"; then
        ok "running Brave" "started with $want"
    else bad "running Brave" "started without some of $want" "quit Brave (menu > Exit) and start it again"; fi
    gpu=$(pgrep -u "$(id -u)" -f -- '--type=gpu-process' | head -1)
    if [ -n "${WAYLAND_DISPLAY:-}" ]; then
        [ -n "$gpu" ] && ok "Brave GPU process" "EGL on Wayland (no Vulkan needed)"
    elif [ -n "$gpu" ] && grep -q 'libvulkan_intel' /proc/"$gpu"/maps 2>/dev/null; then
        ok "Brave GPU process" "Vulkan ($(grep -oE 'libvulkan_intel[a-z_]*' /proc/"$gpu"/maps | head -1))"
    elif [ -n "$gpu" ]; then bad "Brave GPU process" "not using Vulkan" "brave://gpu: check Vulkan / ANGLE backend"; fi
fi
if [ "${1:-}" = --decode ]; then
    if command -v brave-decode-test >/dev/null 2>&1; then
        r=$(brave-decode-test 2>&1)
        rc=$?
        d=$(sed -n 's/^decoder: //p' <<<"$r")
        c=$(sed -n 's/^cpu: *//p' <<<"$r")
        case $rc in
            0) ok "Brave decodes on the GPU (test)" "$d; $c" ;;
            1) bad "Brave decodes on the GPU (test)" "$d; $c" "brave-decode-test shows the media log" ;;
            *) na "Brave decode test" "could not run: $(tail -1 <<<"$r")" ;;
        esac
    fi
else na "Brave decode test" "media-check --decode (about 30 s; plays a clip in a throwaway Brave)"; fi

# ---------------------------------------------------------------- tools
section "Tools"
yd=$(command -v yt-dlp)
case $yd in
    "$HOME"/.local/share/mise/*) ok "yt-dlp" "$("$yd" --version) (mise)" ;;
    "") bad "yt-dlp" "missing" "mise install (yt-dlp in the mise config)" ;;
    *) bad "yt-dlp" "$yd ($("$yd" --version 2>/dev/null)): not from mise" "chezmoi apply (desktop role removes Debian's)" ;;
esac
if dpkg -s yt-dlp >/dev/null 2>&1; then
    bad "Debian yt-dlp" "installed (too old for YouTube)" "chezmoi apply (desktop role removes and pins it out)"
else ok "Debian yt-dlp" "absent"; fi
if grep -q '^hwdec=vaapi' "$HOME/.config/mpv/mpv.conf" 2>/dev/null; then
    ok "mpv" "hwdec=vaapi, H.264 from yt-dlp (yt URL)"
else bad "mpv" "no hwdec=vaapi in ~/.config/mpv/mpv.conf" "chezmoi apply"; fi

echo
if [ "$fails" -eq 0 ]; then
    printf '\e[32mAll as decided.\e[0m  Cost per app: cpu-stat\n'
else printf '\e[31m%d check(s) drifted.\e[0m  Cost per app: cpu-stat\n' "$fails"; fi
exit "$fails"
