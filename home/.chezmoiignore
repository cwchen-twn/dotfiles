{{ if ne .chezmoi.os "linux" }}
.config/systemd
{{ end }}
{{ if or (ne .chezmoi.os "linux") (not .desktop) }}
.local/bin/bt-codec
.config/systemd/user/bt-codec.service
{{ end }}

{{ if not (has "kubernetes" .devops) }}
.kube
{{ end }}
{{- /* SOPS age key (decrypts the hcloud repo secrets): only where infra is worked on */}}
{{ if not (or (has "terraform" .devops) (has "kubernetes" .devops)) }}
.config/sops
{{ end }}
{{- /* VPN profiles: Linux only (installed to /etc by run_onchange_after_55-vpn-configs); on macOS import into Tunnelblick by hand */}}
{{ if or (ne .chezmoi.os "linux") (not (has "openvpn" .extras)) }}
.config/openvpn
{{ end }}
{{ if or (ne .chezmoi.os "linux") (not (has "openfortivpn" .extras)) }}
.config/openfortivpn
{{ end }}
