.config/autostart
.config/fish/functions/printers.fish
.config/fish/functions/printer-add.fish
.config/fish/functions/printer-rm.fish
.config/fish/functions/mem-stat.fish
.config/fish/functions/bt-pair.fish
.local/bin/media-check
.local/bin/cpu-stat
.local/bin/vol
.config/pulse
{{ end }}
{{ if not (has "libinput-gestures" .desktop) }}
.config/libinput-gestures.conf
.config/autostart/libinput-gestures.desktop
{{ end }}
{{ if not (has "fcitx5" .desktop) }}
.config/fcitx5
{{ end }}
{{ if or (ne .chezmoi.os "linux") (not .desktop) }}
.config/fontconfig
{{ end }}
{{ if or (ne .chezmoi.os "linux") (not (has "supersonic" .desktop)) }}
.config/supersonic
.local/share/applications/supersonic.desktop
{{ end }}
{{ if not (has "alacritty" .desktop) }}
.config/alacritty
{{ end }}
{{ if not (has "dbeaver" .desktop) }}
.local/share/DBeaverData
{{ end }}
{{ if not (stat "/sys/class/leds/smc::kbd_backlight") }}
.local/bin/kbd-backlight-idle
.config/autostart/kbd-backlight-idle.desktop
.config/systemd/user/three-finger-drag.service
.config/linux-3-finger-drag
.config/systemd/user/camera-relay.service
.config/fish/functions/camera-on.fish
.config/fish/functions/camera-off.fish
{{ end }}
{{ if not (has "claude-code" .extras) }}
.claude
{{ end }}

