# Managed by chezmoi: edit with `chezmoi edit ~/.config/mise/config.toml`.
# `mise up` upgrades within the constraints below; `mise ls` shows what is installed.

[tools]
# core
lazygit = "latest"
"aqua:neovim/neovim" = "0.12"  # LazyVim needs >= 0.11
glab = "latest"
"forgejo:gitea/tea" = { version = "latest", api_url = "https://gitea.com/api/v1" }
sops = "latest"
age = "latest"
gitleaks = "latest"
bitwarden = "latest"
"github:rtk-ai/rtk" = "0.42.4"
"github:DeusData/codebase-memory-mcp" = "latest"
fzf = "latest"
tree-sitter = "latest"   # nvim-treesitter builds parsers with it
# system info / monitoring (kernel-level ones come from apt, ansible base role)
fastfetch = "latest"     # neofetch successor
btop = "latest"
duf = "latest"           # df
gdu = "latest"           # du, interactive
# network (system-level ones come from apt, ansible base role)
doggo = "latest"         # readable dig
xh = "latest"            # HTTPie-style HTTP client
gping = "latest"         # ping with a graph
grpcurl = "latest"
websocat = "latest"
{{- if has "kubernetes" .devops }}
kubectl = "latest"
helm = "latest"
kubectx = "latest"
{{- end }}
{{- if has "terraform" .devops }}
terraform = "latest"
tflint = "latest"
hcloud = "latest"        # Hetzner Cloud; token from HCLOUD_TOKEN (hcloud repo's mise env) or `hcloud context create`
{{- if has "node" .runtimes }}
wrangler = "latest"      # Cloudflare (npm): Workers, R2, DNS; token from CLOUDFLARE_API_TOKEN
{{- end }}
{{- end }}
{{- if and (eq .chezmoi.os "linux") (has "supersonic" .desktop) }}
# Navidrome/Subsonic music player (Go + libmpv from apt, desktop role); menu entry in ~/.local/share/applications
"github:dweymouth/supersonic" = { version = "latest", asset_pattern = "*linux-x64-libmpv2.tar.xz", bin_path = "supersonic/usr/local/bin" }
{{- end }}
{{- if has "node" .runtimes }}
node = "lts"
pnpm = "latest"
{{- end }}
{{- if has "go" .runtimes }}
go = "latest"
"go:golang.org/x/tools/gopls" = "latest"  # for the Claude gopls-lsp plugin
{{- end }}
{{- if has "java" .runtimes }}
java = "jetbrains-21"
maven = "latest"
gradle = "latest"
{{- end }}

[settings]
experimental = true
# Project mise.toml files can load SOPS-encrypted env (`[env] _.file = "secrets.enc.yaml"`, e.g. hcloud) with this key
sops.age_key_file = "~/.config/sops/age/keys.txt"
idiomatic_version_file_enable_tools = ["node", "go", "java"]
