# Managed by chezmoi (MacBooks). Feeds the FaceTime camera into the v4l2loopback device /dev/video10
# ("FaceTime HD (relay)", fixed 1280x720) for apps that can't use the real one. camera-on / camera-off (fish).
[Unit]
Description=FaceTime camera relay to /dev/video10
ConditionPathExists=/dev/video10

[Service]
ExecStart=/usr/bin/ffmpeg -hide_banner -loglevel warning -f v4l2 -input_format yuyv422 -video_size 1280x720 -framerate 30 -i /dev/video0 -f v4l2 -pix_fmt yuyv422 /dev/video10
Restart=no
