# Managed by chezmoi. Touchpad gestures, macOS-style with three-finger drag on (the touchpad itself is set up by
# /etc/X11/xorg.conf.d/50-macbook-touchpad.conf: tap, natural scrolling, two-finger right-click).
# Three fingers belong to linux-3-finger-drag (MacBooks), so gestures use 4 fingers, like macOS in that mode.
# Reference: /etc/libinput-gestures.conf. Test with `libinput-gestures -d`; reload with `libinput-gestures-setup restart`.
# Gestures fire once when the swipe ends (no animation). Actions are key presses through ~/.local/bin/sendkey
# (xdotool on X11, wtype on Wayland), bound by xfwm4/LXQt there and by ~/.config/labwc/rc.xml in "LXQt (labwc)".

# linux-3-finger-drag grabs the real touchpad and exposes a clone with the same name: listen on all touchpads so
# the clone is used (the grabbed device just stays silent). Harmless without it.
device all

{{- $k := joinPath .chezmoi.homeDir ".local/bin/sendkey" }}
# 4 fingers left/right: previous/next workspace (one row of 4, as set by the ansible lxqt role and labwc's rc.xml).
gesture swipe left   4 {{ $k }} ctrl+alt+Left
gesture swipe right  4 {{ $k }} ctrl+alt+Right

# 4 fingers up: show the desktop. No Mission Control in xfwm4 or labwc.
gesture swipe up     4 {{ $k }} ctrl+alt+d
# 4 fingers down: the main menu (LXQt's on X11, labwc's on Wayland), the closest thing to Launchpad.
gesture swipe down   4 {{ $k }} alt+F1

# Pinch: zoom in/out (browsers, editors, image viewers). Browser back/forward: Alt+Left/Right.
gesture pinch out    {{ $k }} ctrl+plus
gesture pinch in     {{ $k }} ctrl+minus

# Ignore short accidental swipes.
swipe_threshold 50
