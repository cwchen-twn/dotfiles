[Desktop Entry]
# Managed by chezmoi: the system monitor on the desktop (~/.config/conky, two windows). The pause lets kanshi set up
# the monitors first, so Conky measures the final screen width.
Type=Application
Name=Conky
Comment=System monitor on the desktop
Exec=sh -c 'exec "$HOME/.local/bin/conky-desktop" 5'
Icon=utilities-system-monitor
OnlyShowIn=LXQt;
