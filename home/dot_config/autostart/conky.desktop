[Desktop Entry]
# Managed by chezmoi: the system monitor on the desktop (~/.config/conky, two windows). The pause lets pcmanfm-qt draw
# the desktop first, so Conky's layer sits above it.
Type=Application
Name=Conky
Comment=System monitor on the desktop
Exec=sh -c 'exec "$HOME/.local/bin/conky-desktop" 5'
Icon=utilities-system-monitor
OnlyShowIn=LXQt;
