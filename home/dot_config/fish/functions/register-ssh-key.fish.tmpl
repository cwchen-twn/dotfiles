# Managed by chezmoi. Log in to GitHub, GitLab and Gitea (if needed) and upload this machine's SSH key.
function register-ssh-key --description "Upload ~/.ssh/{{ .sshKey }}.pub to GitHub, GitLab and Gitea"
    set -l key ~/.ssh/{{ .sshKey }}.pub
    set -l title (hostname)
    if not test -f $key
        echo "missing $key (chezmoi creates it: chezmoi apply)" >&2
        return 1
    end
    set -l pub (string split -f1,2 ' ' < $key | string join ' ')

    # GitHub
    gh auth status >/dev/null 2>&1; or gh auth login --git-protocol ssh --skip-ssh-key --web
    if gh ssh-key list 2>/dev/null | string match -q "*$pub*"
        echo "GitHub: key already registered"
    else
        gh ssh-key add $key --title $title; and echo "GitHub: key added"
    end

    # GitLab
    glab auth status >/dev/null 2>&1; or glab auth login --hostname gitlab.com
    if glab ssh-key list 2>/dev/null | string match -q "*$pub*"
        echo "GitLab: key already registered"
    else
        glab ssh-key add $key --title $title; and echo "GitLab: key added"
    end

    # Gitea
    if not tea login list 2>/dev/null | string match -q '*git.chenantunez.com*'
        echo "Gitea: create a token at https://git.chenantunez.com/user/settings/applications (scopes: user, repository)"
        read -P "Gitea token: " -s token; or return 1
        tea login add --name chenantunez --url https://git.chenantunez.com --token $token --ssh-key ~/.ssh/{{ .sshKey }}; or return 1
        tea login default chenantunez >/dev/null
    end
    if tea api /user/keys 2>/dev/null | string match -q "*$pub*"
        echo "Gitea: key already registered"
    else
        tea api -X POST /user/keys -f title=$title -f key=(cat $key) >/dev/null; and echo "Gitea: key added"
    end
end
