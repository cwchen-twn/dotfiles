{{- if eq .chezmoi.os "linux" }}
command -q fdfind; and not command -q fd; and alias fd fdfind
alias batinfo "upower -i (upower -e | grep BAT)"
alias sysinfo "inxi -Fxz"
alias nvim-keys "xdg-open ~/.local/share/nvim/cheatsheet.html"   # generated from the live nvim config
command -q tlp-stat; and alias battery "sudo tlp-stat -b"   # health, cycles, charge thresholds
{{- end }}
{{- if and (has "postgres" .extras) (eq .chezmoi.os "linux") }}
# postgres isn't started at boot (memory): start/stop it when needed
alias pgstart "sudo systemctl start postgresql"
alias pgstop "sudo systemctl stop postgresql"
{{- end }}
{{- if and (has "nordvpn" .extras) (eq .chezmoi.os "linux") }}
# nordvpnd isn't started at boot (memory)
alias vpnstart "sudo systemctl start nordvpnd.socket nordvpnd.service"
alias vpnstop "sudo systemctl stop nordvpnd.service nordvpnd.socket"
{{- end }}
{{- if has "nvidia-cuda" .extras }}
alias gputop "watch -n 0.5 nvidia-smi"
{{- end }}

# personal Vaultwarden, kept separate from any work `bw` session
function bwp --wraps bw --description "bw against vw.chenantunez.com"
    BITWARDENCLI_APPDATA_DIR=$HOME/.config/bw-personal bw $argv
end
