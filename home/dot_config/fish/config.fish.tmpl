set fish_greeting ""

set -gx EDITOR nvim
set -gx VISUAL nvim

# PATH: session-scoped and de-duplicated (-g). Don't use universal fish_user_paths.
{{- if eq .chezmoi.os "darwin" }}
test -x /opt/homebrew/bin/brew; and /opt/homebrew/bin/brew shellenv fish | source
{{- end }}
fish_add_path -g ~/bin ~/.local/bin
{{- if has "rust" .runtimes }}
fish_add_path -g ~/.cargo/bin
{{- end }}
{{- if has "go" .runtimes }}
fish_add_path -g -a ~/go/bin
{{- end }}
{{- if has "bun" .runtimes }}
set -gx BUN_INSTALL ~/.bun
fish_add_path -g $BUN_INSTALL/bin
{{- end }}
{{- if has "node" .runtimes }}
set -gx PNPM_HOME {{ if eq .chezmoi.os "darwin" }}~/Library/pnpm{{ else }}~/.local/share/pnpm{{ end }}
fish_add_path -g $PNPM_HOME
{{- end }}
{{- if has "nvidia-cuda" .extras }}
fish_add_path -g -a /usr/local/cuda/bin
{{- end }}

# mise: node, go, java, kubectl, helm, terraform, neovim, ... (see ~/.config/mise/config.toml)
if command -q mise
    mise activate fish | source
end

{{- if eq .chezmoi.os "linux" }}

# ssh-agent from the systemd user unit
if test -z "$SSH_AUTH_SOCK"; and test -S $XDG_RUNTIME_DIR/ssh-agent.socket
    set -gx SSH_AUTH_SOCK $XDG_RUNTIME_DIR/ssh-agent.socket
end
{{- end }}

if status is-interactive
    {{- if has "python" .runtimes }}
    command -q uv; and uv generate-shell-completion fish | source
    {{- end }}
end
