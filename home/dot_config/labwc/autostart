# Managed by chezmoi. Run by labwc at the start of the "LXQt (labwc)" session, before LXQt's own autostart
# (lxqt-session: panel, desktop, notifications, ~/.config/autostart): input method, monitors, idle and lock.

# Input method: Debian's im-launch (autostart) starts fcitx5 only while the input-method variables are as
# im-config set them, and this session unsets GTK_IM_MODULE (GTK uses labwc's text-input; fcitx5 warns otherwise),
# so it is started here.
command -v fcitx5 >/dev/null && fcitx5 -d --replace >/dev/null 2>&1

# Monitors: per-output scale and layout, reapplied on plug/unplug (~/.config/kanshi/config).
kanshi >/dev/null 2>&1 &

# Wallpaper on every monitor, each filled at its own scale, new ones as they are plugged in. The image is the link the
# ansible lxqt role sets (the boot theme's); without it, the Catppuccin base colour. pcmanfm-qt's desktop is off
# (~/.config/autostart/lxqt-desktop.desktop).
swaybg -o '*' -m fill -c '#1e1e2e' -i ~/.local/share/backgrounds/wallpaper >/dev/null 2>&1 &

# Idle and lock:
# - keyboard backlight off after 60 s idle, back on input (MacBooks; harmless elsewhere);
# - lock after 10 min, screens off 5 min later;
# - lock before sleep (-w waits for swaylock to be up) and when logind asks (LXQt's Lock screen, Ctrl+Alt+L).
swayidle -w \
    timeout 60 '~/.local/bin/kbd-backlight-idle off' resume '~/.local/bin/kbd-backlight-idle on' \
    timeout 600 '~/.local/bin/lock-screen' \
    timeout 900 'wlopm --off "*"' resume 'wlopm --on "*"' \
    before-sleep '~/.local/bin/lock-screen' \
    lock '~/.local/bin/lock-screen' >/dev/null 2>&1 &
