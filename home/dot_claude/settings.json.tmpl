{
  "env": {
    "ENABLE_STOP_REVIEW": "0",
    "SG_AGENTIC_MODEL": "sonnet"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v rtk >/dev/null 2>&1 || exit 0; exec rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v codebase-memory-mcp >/dev/null 2>&1 || exit 0; exec codebase-memory-mcp hook-augment",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "command -v codebase-memory-mcp >/dev/null 2>&1 || exit 0; exec codebase-memory-mcp hook-augment",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "command -v codebase-memory-mcp >/dev/null 2>&1 || exit 0; exec codebase-memory-mcp hook-augment",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "command -v codebase-memory-mcp >/dev/null 2>&1 || exit 0; exec codebase-memory-mcp hook-augment",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "command -v codebase-memory-mcp >/dev/null 2>&1 || exit 0; exec codebase-memory-mcp hook-augment",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "command -v codebase-memory-mcp >/dev/null 2>&1 || exit 0; exec codebase-memory-mcp hook-augment",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v codebase-memory-mcp >/dev/null 2>&1 || exit 0; exec codebase-memory-mcp hook-augment",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "cloudflare@cloudflare": true,
    "mason-lsp@cwchen-local": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "cwchen-local": {
      "source": {
        "source": "directory",
        "path": {{ joinPath .chezmoi.workingTree "claude-plugins" | toJson }}
      }
    }
  },
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
