{
  "env": {
    "ENABLE_STOP_REVIEW": "0",
    "SG_AGENTIC_MODEL": "sonnet"
  },
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(git push -u origin *)",
      "Bash(git push origin *)",
      "Bash(mise exec -- git push -u origin *)",
      "Bash(mise exec -- git push origin *)",
      "Bash(tea pulls create *)",
      "Bash(glab mr create *)",
      "Bash(gh pr create *)"
    ],
    "ask": [
      "Bash(*git push * main)",
      "Bash(*git push *:main)",
      "Bash(*git push *refs/heads/main*)",
      "Bash(*git push * master)",
      "Bash(*git push *:master)",
      "Bash(*git push *HEAD*)",
      "Bash(*git push * @*)",
      "Bash(*git push * :*)",
      "Bash(*git push *--tags*)",
      "Bash(*git push *--force*)",
      "Bash(*git push * -f*)",
      "Bash(*git push *+*)",
      "Bash(*git push *--delete*)",
      "Bash(*git push * -d *)",
      "Bash(*git push *--mirror*)",
      "Bash(*git push *--no-verify*)",
      "Bash(tea pulls merge *)",
      "Bash(glab mr merge *)",
      "Bash(gh pr merge *)",
      "Bash(git tag *)",
      "Bash(make release *)",
      "Bash(make deploy*)"
    ]
  },
  "autoMode": {
    "environment": [
      "$defaults",
      "Source control: the user's own forges (self-hosted Gitea via tea, GitLab via glab, GitHub via gh). Pushing an <issue>-<slug> feature branch and opening a draft PR/MR on it is routine once make audit passes, which the pre-push hook enforces. Merging, marking ready, force-pushing, pushing to main, tags and deploys are not routine."
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v codebase-memory-mcp >/dev/null 2>&1 || exit 0; exec codebase-memory-mcp hook-augment",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "command -v codebase-memory-mcp >/dev/null 2>&1 || exit 0; exec codebase-memory-mcp hook-augment",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "command -v codebase-memory-mcp >/dev/null 2>&1 || exit 0; exec codebase-memory-mcp hook-augment",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "command -v codebase-memory-mcp >/dev/null 2>&1 || exit 0; exec codebase-memory-mcp hook-augment",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "command -v codebase-memory-mcp >/dev/null 2>&1 || exit 0; exec codebase-memory-mcp hook-augment",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "command -v codebase-memory-mcp >/dev/null 2>&1 || exit 0; exec codebase-memory-mcp hook-augment",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v codebase-memory-mcp >/dev/null 2>&1 || exit 0; exec codebase-memory-mcp hook-augment",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "cloudflare@cloudflare": true,
    "mason-lsp@cwchen-local": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "cwchen-local": {
      "source": {
        "source": "directory",
        "path": {{ joinPath .chezmoi.workingTree "claude-plugins" | toJson }}
      }
    }
  },
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
