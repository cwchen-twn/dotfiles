# ~/.profile: login shells (bash/sh, display managers). Managed by chezmoi.
# shellcheck shell=sh

if [ -n "$BASH_VERSION" ] && [ -f "$HOME/.bashrc" ]; then
    . "$HOME/.bashrc"
fi

# Each is prepended, so the last wins: Mason's language servers (nvim, shared with Claude Code) come before
# ~/.cargo/bin, whose rustup rust-analyzer stub must not shadow Mason's.
for d in "$HOME/bin" "$HOME/.local/bin"{{ if has "rust" .runtimes }} "$HOME/.cargo/bin"{{ end }} "$HOME/.local/share/nvim/mason/bin"; do
    case ":$PATH:" in *":$d:"*) ;; *) [ -d "$d" ] && PATH="$d:$PATH" ;; esac
done
export PATH

export EDITOR=nvim
{{- if has "kubernetes" .devops }}
export KUBECONFIG="$HOME/.kube/config:$HOME/.kube/clusters.yaml"
{{- end }}

# mise shims so GUI apps / non-interactive shells see mise-managed tools
if command -v mise >/dev/null 2>&1; then
    eval "$(mise activate bash --shims)"
fi
