{{ if has "claude-code" .extras -}}
#!/usr/bin/env bash
# claude data hash: {{ .claude | toJson | sha256sum }}
# local plugins hash: {{ output "sh" "-c" (printf "cat \"%s\"/claude-plugins/*/.claude-plugin/*.json \"%s\"/claude-plugins/.claude-plugin/*.json | sha256sum" .chezmoi.workingTree .chezmoi.workingTree) | trim }}
set -euo pipefail
# chezmoi scripts do not get the interactive PATH: claude lives in ~/.local/bin, MCP servers and the
# toolkit CLIs come from mise, language servers from Mason (nvim).
export PATH="$HOME/.local/bin:$HOME/.local/share/nvim/mason/bin:$HOME/.local/share/mise/shims:$PATH"
command -v claude >/dev/null 2>&1 || { echo "claude not installed, skipping plugin/MCP setup"; exit 0; }

{{ range .claude.remove -}}
claude plugin uninstall {{ . | quote }} --scope user >/dev/null 2>&1 && echo "plugin {{ . }} uninstalled" || true
{{ end -}}
{{ range .claude.removeMarketplaces -}}
claude plugin marketplace remove {{ . | quote }} >/dev/null 2>&1 || true
{{ end -}}
{{ range .claude.marketplaces -}}
claude plugin marketplace add {{ . | quote }} >/dev/null 2>&1 || true
{{ end -}}
# This repo's own marketplace (claude-plugins/); update re-reads it after a change.
claude plugin marketplace add {{ joinPath .chezmoi.workingTree "claude-plugins" | quote }} >/dev/null 2>&1 \
    || claude plugin marketplace update cwchen-local >/dev/null 2>&1 || true
{{ range .claude.plugins -}}
claude plugin install {{ . | quote }} --scope user >/dev/null 2>&1 || echo "plugin {{ . }} not installed (already present or failed)"
{{ end -}}
claude plugin update mason-lsp@cwchen-local --scope user >/dev/null 2>&1 || true
{{ range $name, $cmd := .claude.mcpServers -}}
claude mcp get {{ $name | quote }} >/dev/null 2>&1 || claude mcp add --scope user {{ $name | quote }} -- {{ range $cmd }}{{ . | quote }} {{ end }}\
    || echo "MCP server {{ $name }} NOT registered" >&2
command -v {{ index $cmd 0 | quote }} >/dev/null 2>&1 || echo "MCP server {{ $name }}: {{ index $cmd 0 }} not on PATH (mise install?)" >&2
{{ end -}}

# Remote MCP servers that take an API key, authenticated on every machine without OAuth: claude-mcp-headers (the
# headersHelper) sends `Authorization: Bearer` from ~/.config/claude-mcp/<name>, an age-encrypted chezmoi file added
# with `claude-mcp-key <name>`. The key is read per connection, so adding or rotating one needs no re-registration.
# User scope outranks plugins, so this `cloudflare` replaces the cloudflare plugin's own copy (its skills stay).
# run_after_41-claude-reminders.sh says which keys are still missing.
{{- range $name, $url := .claude.keyedMcpServers }}
want={{ dict "type" "http" "url" $url "headersHelper" (joinPath $.chezmoi.homeDir ".local/bin/claude-mcp-headers") | toJson | quote }}
# Re-register only when the user-scope entry differs (`claude mcp get` doesn't show headersHelper; ~/.claude.json does).
if [[ "$(jq -c --arg n {{ $name | quote }} '.mcpServers[$n] // {} | {headersHelper, type, url}' "$HOME/.claude.json" 2>/dev/null)" \
      != "$(jq -c '{headersHelper, type, url}' <<<"$want")" ]]; then
    claude mcp remove {{ $name | quote }} --scope user >/dev/null 2>&1 || true
    claude mcp add-json --scope user {{ $name | quote }} "$want" >/dev/null || echo "MCP server {{ $name }} NOT registered" >&2
fi
{{- end }}

# mason-lsp serves every language we use, so Claude Code's "install <lang>-lsp plugin?" suggestions only offer
# duplicates (they fire whenever an official plugin's server binary is on PATH, and Mason puts them there). Same key
# as the dialog's "Disable all LSP recommendations"; ~/.claude.json is rewritten atomically, and only when needed.
CJ="$HOME/.claude.json"
if [[ -f $CJ ]] && [[ "$(jq -r '.lspRecommendationDisabled // false' "$CJ" 2>/dev/null)" != true ]]; then
    if ! { tmp=$(mktemp "$CJ.XXXXXX") && jq '.lspRecommendationDisabled = true' "$CJ" >"$tmp" && mv "$tmp" "$CJ"; }; then
        rm -f "${tmp:-}"
        echo "could not turn off LSP plugin suggestions in $CJ" >&2
    fi
fi

# Language servers: installed by run_onchange_after_35-nvim-mason (Mason, from the nvim config).
missing=()
for bin in{{ range .claude.lspBinaries }} {{ . }}{{ end }}; do
    command -v "$bin" >/dev/null 2>&1 || missing+=("$bin")
done
((${#missing[@]} == 0)) || echo "LSP servers not on PATH (the Mason sync script, 35-nvim-mason, failed for them; see its output): ${missing[*]}" >&2

{{- if not (has "brave" .desktop) }}
# No Brave here: the e2e-tester agent's Playwright MCP needs its own Chromium build (a no-op when present).
# perf-auditor (chrome-devtools-mcp) then needs Chrome installed.
if command -v playwright-mcp >/dev/null 2>&1; then
    playwright-mcp install-browser chrome-for-testing >/dev/null 2>&1 \
        || echo "playwright-mcp install-browser failed: the e2e-tester agent has no browser" >&2
fi
{{- end }}
{{ end -}}
