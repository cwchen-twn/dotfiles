{{ if not (has "genmedia" .extras) -}}
#!/usr/bin/env bash
# The genmedia extra is off: delete what it deployed. chezmoi ignores these paths then (.chezmoiignore) and never deletes
# what it ignores; the ansible genmedia role removes its Chrome symlink. Runs on every apply: a few no-op checks.
set -eu
for p in .local/bin/genmedia .claude/skills/media-assets .config/agents/skills/media-assets; do
    if [ -e "$HOME/$p" ] || [ -L "$HOME/$p" ]; then
        rm -rf "${HOME:?}/$p"
        echo "genmedia off: removed ~/$p"
    fi
done
{{ end -}}
