#!/usr/bin/env bash
# Ensure this machine has its own SSH key for git hosts. Registering it needs gh/glab/tea logins,
# which a fresh machine doesn't have yet: that's `register-ssh-key` (fish), run after bootstrap.
set -euo pipefail
KEY="$HOME/.ssh/{{ .sshKey }}"
[ -f "$KEY" ] && exit 0
mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
ssh-keygen -t ed25519 -C "{{ .name }}@{{ .chezmoi.hostname }}" -f "$KEY"
echo "New SSH key $KEY: run 'register-ssh-key' to log in to GitHub/GitLab/Gitea and upload it."
