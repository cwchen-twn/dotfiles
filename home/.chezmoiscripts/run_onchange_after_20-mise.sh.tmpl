#!/usr/bin/env bash
# mise config hash: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }} {{ dict "devops" .devops "runtimes" .runtimes | toJson | sha256sum }}
set -euo pipefail
command -v mise >/dev/null 2>&1 || { echo "mise not found, skipping"; exit 0; }
mise trust "$HOME/.config/mise/config.toml" >/dev/null 2>&1 || true
mise install --yes
