{{ if and (eq .chezmoi.os "linux") .desktop -}}
#!/usr/bin/env bash
# Linux desktops: (re)start the desktop system monitor (~/.local/bin/conky-desktop) when its files change, so a
# layout change shows without logging out. conky comes from mise (script 20, before this; upstream's AppImage).
# A running kanshi rereads its config first: its profiles run conky-desktop on every monitor change.
# Docked, conky-desktop moves the cursor to the laptop panel's top-left corner (Conky opens next to the cursor).
# Outside a graphical session (ssh, the first install from a console) kanshi and the autostart entry start it at
# next login.
# conky hash: {{ range (glob (joinPath .chezmoi.sourceDir "dot_config/conky/*")) }}{{ include . | sha256sum }}{{ end }}
# script hash: {{ include "dot_local/bin/executable_conky-desktop" | sha256sum }}
# kanshi hash: {{ include "dot_config/kanshi/config" | sha256sum }}
set -euo pipefail
command -v conky >/dev/null 2>&1 || { echo "conky not installed, skipping"; exit 0; }
[ -n "${WAYLAND_DISPLAY:-}" ] || { echo "no graphical session: conky starts at next login"; exit 0; }
if pgrep -x kanshi >/dev/null; then kanshictl reload || true; fi
"$HOME/.local/bin/conky-desktop"
{{ end -}}
