{{ if has "claude-code" .extras -}}
#!/usr/bin/env bash
# Runs on every apply: one-line reminders for Claude Code setup that needs a human. Silent when everything is done.
export PATH="$HOME/.local/bin:$PATH"
command -v claude >/dev/null 2>&1 || exit 0
{{- range $name, $url := .claude.keyedMcpServers }}
if [[ ! -s "$HOME/.config/claude-mcp/{{ $name }}" ]]; then
    echo "REMINDER: MCP server {{ $name }} has no API key on this machine: run \`claude-mcp-key {{ $name }}\` once" \
         "(the key is then age-encrypted in the dotfiles, and every machine gets it)." >&2
fi
{{- end }}
exit 0
{{ end -}}
